class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        int n = nums.size() ;
        map<int,int> mp ;
        for (int i = 0 ; i < n ; ++i) {
            if (mp[target-nums[i]] > 0 ) {
                int x = target - nums[i] ; 
                int ind = find(nums.begin(),nums.end(),x) - nums.begin() ;
                return {ind,i} ;
            }
            mp[nums[i]]++ ;

        }
        return {};
    }
};
